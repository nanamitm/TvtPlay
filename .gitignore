BonDriver_Pipe_src/x64/
BonDriver_Pipe_src/Release/
BonDriver_Pipe_src/Debug/
TvtAudioStretchFilter_src/x64/
TvtAudioStretchFilter_src/Release/
TvtAudioStretchFilter_src/Debug/

# Release archives built by the workflow
dist/

# Visual Studio per-user state and its browsing database
.vs/
*.vcxproj.user
*.aps

